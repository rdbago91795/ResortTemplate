# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env* is gitignored except this file.
#
# ⚠ ONLY these three variables may carry a VITE_ prefix.
#
# Vite inlines every VITE_-prefixed variable into the client bundle at build time.
# It is not hidden, not obfuscated, and not recoverable once shipped — it is published.
# There is no such thing as a secret VITE_ variable (security-baseline.md §3.1).
#
# The anon key being public is the whole premise of the model: its safety comes
# entirely from Row Level Security.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — Edge Function environment only. Never here, never with a VITE_ prefix,
# never in the client bundle. Listed for reference; set them with
# `supabase secrets set` (security-baseline.md §3.2).
#
#   SUPABASE_SERVICE_ROLE_KEY   bypasses all RLS
#   RESEND_API_KEY
#   RESEND_WEBHOOK_SECRET
#   TURNSTILE_SECRET_KEY
#   RATE_LIMIT_SALT
# ─────────────────────────────────────────────────────────────────────────────
